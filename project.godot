; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Pokémon Pilot"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://art/icon.png"

[autoload]

Events="*res://scripts/autoload/events.gd"
DB="*res://scripts/autoload/db.gd"
GameState="*res://scripts/autoload/game_state.gd"
Sound="*res://scripts/autoload/sound.gd"
Controls="*res://scripts/autoload/controls.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Net="*res://scripts/autoload/net.gd"
Autotest="*res://scripts/autoload/autotest.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor]

export/convert_text_resources_to_binary=false

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="agua"
2d_physics/layer_3="jugador"
2d_physics/layer_4="criatura_aliada"
2d_physics/layer_5="criatura_salvaje"
2d_physics/layer_6="hurtbox_aliada"
2d_physics/layer_7="hurtbox_salvaje"
2d_physics/layer_8="entorno"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
viewport/hdr_2d=true
