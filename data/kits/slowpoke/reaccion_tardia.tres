[resource]
script = ExtResource("2_sd")
id = "reaccion_tardia"
display_name = "Reacción Tardía"
description = "De cada golpe recibe ahora el 70%; el resto le llega 2 s tarde, salvo que en ese tiempo él conecte un golpe. Bostezo: si el rival sigue con sueño a los 2 s, se duerme."
color = Color(1.0, 0.6, 0.7, 1)
max_value = 100.0
gains = {}
decay_out_of_combat = 6.0
mechanic_script = ExtResource("1_mech")
params = {"now_part": 0.7, "delay": 2.0, "yawn_status": "bostezo", "yawn_delay": 2.0}
