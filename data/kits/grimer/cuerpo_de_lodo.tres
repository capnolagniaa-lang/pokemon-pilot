[ext_resource type="Script" path="res://scripts/resources/signature_data.gd" id="2_sd"]

[resource]
script = ExtResource("2_sd")
id = "cuerpo_de_lodo"
display_name = "Cuerpo de Lodo"
description = "No lo ralentizan ni lo envenenan. Al que le pega cuerpo a cuerpo lo deja pegoteado (ralentizado). Derretirse lo vuelve un charco que se desliza dejando lodo tóxico."
color = Color(0.6, 0.45, 0.7, 1)
max_value = 0.0
gains = {}
decay_out_of_combat = 6.0
mechanic_script = ExtResource("1_mech")
params = {"immune": ["ralentizado", "envenenado"], "thorns": 0.05, "thorns_status": "ralentizado", "thorns_chance": 1.0}
