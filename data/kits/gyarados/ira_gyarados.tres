[ext_resource type="Script" path="res://scripts/resources/signature_data.gd" id="2_sd"]

[resource]
script = ExtResource("2_sd")
id = "ira_gyarados"
display_name = "Ira de Dragón"
description = "Sube al recibir golpes (y un poco al pegar). Llena, Gyarados se enfurece 5 s: pega 30% más y se mueve más rápido."
color = Color(0.3, 0.5, 1.0, 1)
max_value = 100.0
gains = {"damage_received": 15.0, "hit_dealt": 4.0}
decay_out_of_combat = 6.0
mechanic_script = ExtResource("1_mech")
params = {"self_status": "enfurecido"}
