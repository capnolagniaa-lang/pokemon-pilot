[ext_resource type="Script" path="res://scripts/resources/signature_data.gd" id="2_sd"]

[resource]
script = ExtResource("2_sd")
id = "toma_de_tierra"
display_name = "Toma de Tierra"
description = "Jefe. La barra sube al pegar y al recibir; llena, planta la cola 1 s (quieto: castigalo) y suelta una descarga en anillo que deja el suelo chamuscado y electrificado 8 s. Cuerpo ×1,3, casi no lo empujan. A mitad de vida entra en Sobrecarga (+20% de daño) hasta el final."
color = Color(1.0, 0.85, 0.25, 1)
max_value = 100.0
gains = {"hit_dealt": 9.0, "damage_received": 7.0}
decay_out_of_combat = 6.0
mechanic_script = ExtResource("1_mech")
params = {"plant_status": "plantado", "plant_time": 1.0, "discharge_move": "res://data/kits/raichu/descarga_cola.tres", "ground_state": "chamuscado_electrico", "ground_radius": 56.0, "scale": 1.3, "knockback_mult": 0.35, "phase_at": 0.5, "phase_status": "sobrecarga"}
