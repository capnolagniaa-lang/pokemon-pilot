[resource]
script = ExtResource("2_sd")
id = "luz_de_luna"
display_name = "Luz de Luna"
description = "Metrónomo lanza un ataque al azar de cualquier kit del juego. Cada uno carga la luna (3 marcas); con la luna llena, el próximo elige entre los 5 más fuertes."
