[resource]
script = ExtResource("2_sd")
id = "puas_venenosas"
display_name = "Púas Venenosas"
description = "Al que le pega cuerpo a cuerpo le devuelve 10% del daño y puede envenenarlo; con Refuerzo, 20% y veneno seguro. Mordisco pega ×1,5 a lo envenenado."
