params = {"thorns": 0.1, "thorns_boosted": 0.2, "thorns_status": "envenenado", "thorns_chance": 0.5, "thorns_boost_status": "refuerzo", "bonus_vs_status": "envenenado", "bonus_move_prefix": "mordisco", "bonus_mult": 1.5}
