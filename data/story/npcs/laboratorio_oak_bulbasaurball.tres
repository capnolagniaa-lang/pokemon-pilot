[gd_resource type="Resource" script_class="NpcData" format=3]

[ext_resource type="Script" path="res://scripts/resources/npc_data.gd" id="1_n"]
[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]
[ext_resource type="Resource" path="res://data/species/bulbasaur.tres" id="r_2"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
requires = PackedStringArray("tiene_inicial")
lines = PackedStringArray("Mejor no. Ya tenés a tu compañero.")

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
set_flags = PackedStringArray("tiene_inicial", "inicial_bulbasaur", "rival_charmander")
lines = PackedStringArray("¡Es Bulbasaur, el Pokémon tipo planta!", "Su estilo es el control: domina la cancha con látigos, polvos y esporas.")
confirm = "¿Querés a Bulbasaur?"
give_pokemon = ExtResource("r_2")
after_speaker = "Azul"
after_lines = PackedStringArray("¡Entonces yo me quedo con este!", "(Azul agarró la Poké Ball de Charmander.)")

[resource]
script = ExtResource("1_n")
id = "laboratorio_oak_bulbasaurball"
display_name = "Poké Ball"
zone_id = "laboratorio_oak"
cell = Vector2i(8, 4)
gfx = "item_ball"
facing = Vector2i(0, 1)
look_around = false
talks = Array[ExtResource("2_t")]([SubResource("Talk_0"), SubResource("Talk_1")])
show_if = PackedStringArray("oak_te_freno")
hide_if = PackedStringArray("inicial_bulbasaur", "rival_bulbasaur")
