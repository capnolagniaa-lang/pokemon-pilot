[sub_resource type="Resource" id="Talk_2"]
script = ExtResource("2_t")
lines = PackedStringArray("Guarda: Adentro de la MO04 está Fuerza. Con ella los Pokémon mueven rocas enormes fuera del combate.", "Ah, ¿encontraste la Casa Secreta de la Zona Safari?")

