[gd_resource type="Resource" script_class="NpcData" format=3]

[ext_resource type="Script" path="res://scripts/resources/npc_data.gd" id="1_n"]
[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("muestra_pocion")
set_flags = PackedStringArray("muestra_pocion")
lines = PackedStringArray("Eeeh... ¿qué hacés, pibe? Tranqui, tranqui.", "Trabajo en la Tienda Pokémon de Ciudad Verde... Estoy en mi descanso, ¿viste?", "Me mandaron a repartir muestras gratis. Pero mirá qué linda está la ruta... da para quedarse.", "Tomá, llevate una Poción. Y no le digas a mi jefe que me viste acá, ¿eh?")
give_items = {"pocion": 1}

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("Uh... ¿ya te di la Poción, no? Se me mezcla todo.", "Si necesitás Poké Balls pasate por la Tienda. Yo vuelvo... en un rato.")

[resource]
script = ExtResource("1_n")
id = "ruta1_martclerk"
display_name = "Empleado de la Tienda"
zone_id = "ruta1"
cell = Vector2i(44, 48)
gfx = "clerk"
facing = Vector2i(0, 1)
look_around = true
