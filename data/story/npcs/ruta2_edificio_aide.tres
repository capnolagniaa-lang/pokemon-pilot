[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("mo05_recibida")
set_flags = PackedStringArray("mo05_recibida")
lines = PackedStringArray("¡Hola! ¿Te acordás de mí? Soy uno de los ayudantes del Profesor Oak.", "Si tu Pokédex ya tiene datos de varias especies, me toca darte un premio.", "El profe me encargó esta MO05 para vos. ¡Felicitaciones, tomá!")
give_items = {"mo05": 1}

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("La MO05 tiene Destello: ilumina hasta las cuevas más oscuras.", "Acordate: las MT y las MO no se gastan.")

[resource]
script = ExtResource("1_n")
