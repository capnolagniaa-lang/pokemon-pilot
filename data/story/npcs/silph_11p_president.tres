[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
requires = PackedStringArray("silph_liberada")
forbids = PackedStringArray("master_ball_recibida")
set_flags = PackedStringArray("master_ball_recibida")
lines = PackedStringArray("Presidente: ¡Ay, muchacho! Gracias por salvar a Silph.", "Nunca me voy a olvidar de que nos salvaste en el peor momento. Te tengo que agradecer de alguna forma.", "Como soy rico, te puedo dar cualquier cosa... Tomá, esto puede servir: la Master Ball.")
give_items = {"master_ball": 1}

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
requires = PackedStringArray("silph_liberada")
lines = PackedStringArray("Presidente: Eso no se compra en ningún lado. Es nuestro prototipo secreto, la Master Ball.", "¡Atrapa a cualquier Pokémon sin fallar! Eso sí, usala con discreción.")

[sub_resource type="Resource" id="Talk_2"]
script = ExtResource("2_t")
lines = PackedStringArray("(El presidente está asustado y no habla.)")

[resource]
