lines = {"desafio": "¡Hola! Soy Misty, la líder del Gimnasio de Ciudad Celeste.|Mi política es atacar con Pokémon de tipo agua. ¿Te animás a meterte a la pileta?", "pierde": "¡Uf! Sos muy bueno... ¡Está bien, te ganaste la Medalla Cascada!", "gana": "¡Te hundiste! Volvé cuando sepas nadar.", "despues": "Con la Medalla Cascada tus Pokémon te hacen más caso. ¡Seguí así!"}
