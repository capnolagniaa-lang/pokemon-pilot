[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
set_flags = PackedStringArray("bill_ayudado")
lines = PackedStringArray("¡Ey! ¡No soy un Pokémon! ¡Soy Bill, el maniático de los Pokémon!", "Un experimento me salió mal y quedé mezclado con un Clefairy.", "¿Me hacés un favor? Metete en la máquina... ¡no, yo me meto! Vos activá el Separador en la PC.")
confirm = "¿Activás el Separador Celular de la PC?"
after_speaker = ""
after_lines = PackedStringArray("(Activaste el Separador Celular. ¡La máquina hace un ruido raro!)")

[resource]
