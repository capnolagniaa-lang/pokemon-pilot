[gd_resource type="Resource" script_class="NpcData" format=3]

[ext_resource type="Script" path="res://scripts/resources/npc_data.gd" id="1_n"]
[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("tiene_corte")
set_flags = PackedStringArray("tiene_corte")
lines = PackedStringArray("Capitán: Uuugh... Me siento horrible... ¡Puaj! Mareado...", "(Le frotás la espalda al capitán... frota, frota...)", "Capitán: ¡Uf! ¡Gracias! Ya me siento mucho mejor.", "¿Querías ver mi técnica secreta de Corte? Te la mostraría si no estuviera tan mal...", "¡Ya sé! ¡Tomá esta MO! Es Corte: caminá contra un árbol fino y tu Pokémon lo corta.", "Para usarla fuera de combate necesitás la Medalla Cascada.")
give_items = {"mo01": 1}

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("Capitán: ¡Uf! Ahora que ya no estoy mareado, es hora: el S.S. Anne zarpa enseguida.", "Con Corte podés cortar los árboles chiquitos. ¿Por qué no probás con los de Ciudad Carmín?")

[resource]
script = ExtResource("1_n")
id = "ss_anne_capitan_captain"
display_name = "Capitán"
zone_id = "ss_anne_capitan"
cell = Vector2i(5, 4)
gfx = "captain"
facing = Vector2i(0, -1)
look_around = false
talks = Array[ExtResource("2_t")]([SubResource("Talk_0"), SubResource("Talk_1")])
