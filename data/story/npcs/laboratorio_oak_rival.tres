requires_flag = "rival_bulbasaur"

[sub_resource type="Resource" id="Trainer"]
script = ExtResource("r_6")
id = "azul"
display_name = "Azul"
title = "Rival"
starting_team = Array[ExtResource("r_2")]([SubResource("Mon_0"), SubResource("Mon_1"), SubResource("Mon_2")])
lines = {"desafio": "¡Esperá! ¡Veamos qué tan buenos son nuestros Pokémon!", "pierde": "¿¡Qué!? ¡Elegí mal mi Pokémon!", "gana": "¡Ja! ¡Gané! Sabía que el mío era mejor.", "despues": "La próxima no te salvás."}
arena_id = "arena_campo"

[resource]
