[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("tiene_inicial")
lines = PackedStringArray("¡Abuelo! ¡Me aburro de esperar!", "¿Eh? ¿Vos también vas a elegir? Dale, elegí primero. Yo soy re generoso.")

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("Mi Pokémon es mucho mejor que el tuyo. Ya vas a ver.")

[sub_resource type="Resource" id="Mon_0"]
