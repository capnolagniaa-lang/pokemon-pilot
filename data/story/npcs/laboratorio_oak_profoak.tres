[gd_resource type="Resource" script_class="NpcData" format=3]

[ext_resource type="Script" path="res://scripts/resources/npc_data.gd" id="1_n"]
[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("tiene_inicial")
lines = PackedStringArray("Ahí en la mesa hay tres Poké Balls. Adentro de cada una hay un Pokémon.", "Elegí el que más te guste. ¡Va a ser tu primer compañero!")

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
forbids = PackedStringArray("rival_lab_peleado")
lines = PackedStringArray("¡Ese Pokémon ya es tuyo! Cuidalo mucho.")

[sub_resource type="Resource" id="Talk_2"]
script = ExtResource("2_t")
requires = PackedStringArray("tiene_paquete")
forbids = PackedStringArray("paquete_entregado")
set_flags = PackedStringArray("paquete_entregado", "tiene_pokedex")
lines = PackedStringArray("¡Ah, mi correo! Muchas gracias.", "Te tengo un regalo: ¡la Pokédex! Registra cada Pokémon que ves y con el que peleás.", "Y llevate estas Poké Balls. Debilitá al Pokémon y lanzala con E.", "Completar la Pokédex es mi sueño de toda la vida. ¿Me ayudás?")
give_items = {"poke_ball": 5}
take_items = {"paquete_oak": 1}
after_speaker = ""
after_lines = PackedStringArray("¡Recibiste la Pokédex! (Esc → Pokédex)")

[sub_resource type="Resource" id="Talk_3"]
script = ExtResource("2_t")
requires = PackedStringArray("paquete_entregado")
lines = PackedStringArray("¿Cómo va esa Pokédex? Cada Pokémon nuevo que veas queda registrado.", "Al norte de Ciudad Verde está el Bosque Verde. ¡Hay muchos Pokémon bicho!")

[sub_resource type="Resource" id="Talk_4"]
script = ExtResource("2_t")
lines = PackedStringArray("¿Pasaste por Ciudad Verde? Está al norte, cruzando la Ruta 1.")

[resource]
script = ExtResource("1_n")
id = "laboratorio_oak_profoak"
display_name = "Prof. Oak"
zone_id = "laboratorio_oak"
cell = Vector2i(6, 3)
gfx = "prof_oak"
facing = Vector2i(0, 1)
look_around = false
talks = Array[ExtResource("2_t")]([SubResource("Talk_0"), SubResource("Talk_1"), SubResource("Talk_2"), SubResource("Talk_3"), SubResource("Talk_4")])
show_if = PackedStringArray("oak_te_freno")
