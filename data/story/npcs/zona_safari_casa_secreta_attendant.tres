[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("mo03_recibido")
set_flags = PackedStringArray("mo03_recibido")
lines = PackedStringArray("¡Ah! ¡Por fin! ¡Sos la primera persona que llega a la Casa Secreta!", "Hice una campaña para la inauguración, y ya me preocupaba que nadie ganara el premio.", "¡Felicitaciones! ¡Ganaste la MO03!")
give_items = {"mo03": 1}

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("La MO03 es Surf: con ella los Pokémon te llevan por el agua.", "Y no se gasta, así que la podés usar todas las veces que quieras. ¡Qué suerte tuviste!")

[resource]
script = ExtResource("1_n")
