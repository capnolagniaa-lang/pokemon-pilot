[ext_resource type="Resource" path="res://data/species/lapras.tres" id="r_2"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("lapras_recibido")
set_flags = PackedStringArray("lapras_recibido")
lines = PackedStringArray("¡Ah! ¡Hola! No sos un Rocket. ¿Viniste a salvarnos? ¡Gracias!", "Te quiero dar este Pokémon por salvarnos: es un Lapras.", "Es un Pokémon muy inteligente. Lo teníamos en el laboratorio, pero con vos va a estar mucho mejor.")
