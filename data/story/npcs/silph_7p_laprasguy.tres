give_level = 25

[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("Creo que vas a ser un buen entrenador para Lapras.", "Nada muy bien: ¡te puede llevar por el agua!")

