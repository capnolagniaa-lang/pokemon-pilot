[sub_resource type="Resource" id="Talk_1"]
script = ExtResource("2_t")
lines = PackedStringArray("Hola, tesoro. ¿Te gustó mi té? Nada quita la sed como un té calentito.", "Por cierto, ¿vos sos de Pueblo Paleta? Hay una chica de ahí, Dalia, que toma té todos los días.")

