[ext_resource type="Script" path="res://scripts/resources/npc_talk.gd" id="2_t"]

[sub_resource type="Resource" id="Talk_0"]
script = ExtResource("2_t")
forbids = PackedStringArray("te_recibido")
set_flags = PackedStringArray("te_recibido")
lines = PackedStringArray("Mis queridos Pokémon me hacen compañía. ¡Meowth hasta trae plata a casa!", "No gastes toda tu plata en bebidas, tesoro. Mejor probá esto: un té.")
