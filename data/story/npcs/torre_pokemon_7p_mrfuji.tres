[sub_resource type="Resource" id="Talk_3"]
script = ExtResource("2_t")
set_flags = PackedStringArray("fuji_rescatado")
lines = PackedStringArray("Sr. Fuji: ¿Eh? ¿Viniste a salvarme? Gracias.", "Pero vine por mi cuenta, a calmar el espíritu de la mamá de Cubone.", "Creo que el espíritu de Marowak por fin nos dejó. Te agradezco que te preocupes.", "Tomá, quiero que tengas esto: la Poké Flauta. Su melodía despierta a los Pokémon dormidos.", "Probala con los Pokémon que duermen tapando el camino.")
give_items = {"poke_flauta": 1}

