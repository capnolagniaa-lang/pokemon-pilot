[sub_resource type="Resource" id="Talk_3"]
script = ExtResource("2_t")
set_flags = PackedStringArray("fuji_rescatado")
lines = PackedStringArray("Gracias... Gracias por salvarme. Soy Fuji, cuido a los Pokémon que no tienen a nadie.", "El Team Rocket mató a la mamá de un Cubone... gracias a vos, su espíritu ya descansa.", "Tomá esto: es la Poké Flauta. Su melodía despierta a cualquier Pokémon dormido.", "Dicen que hay Snorlax durmiendo en las Rutas 12 y 16. Te va a servir.")
give_items = {"poke_flauta": 1}

